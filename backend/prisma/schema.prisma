generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  DM
  TEXT
}

enum MessageFormat {
  TEXT
  E2EE
}

model User {
  id String @id
  username String @unique
  password String
  sessions Session[]

  sentRequests FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  friendshipsA Friendship[] @relation("FriendshipUserA")
  friendshipsB Friendship[] @relation("FriendshipUserB")

  channelMembers ChannelMember[]
  messages Message[]
}

model FriendRequest {
  id String @id
  senderId String
  receiverId String
  createdAt DateTime @default(now())

  sender User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Friendship {
  id String @id
  userAId String
  userBId String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Session {
  id String @id
  userId String
  expiresAt DateTime

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model Channel {
  id String @id
  type ChannelType @default(DM)
  name String?
  serverId String?
  dmKey String? @unique
  createdAt DateTime @default(now())

  members ChannelMember[]
  messages Message[]

  @@index([serverId])
}

model ChannelMember {
  id String @id
  channelId String
  userId String

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model Message {
  id String @id
  channelId String
  senderId String
  content String
  format MessageFormat @default(TEXT)
  clientNonce String?
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([channelId, senderId, clientNonce])
  @@index([channelId, createdAt, id])
}
