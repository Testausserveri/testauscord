generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  DM
  TEXT
}

enum MessageFormat {
  TEXT
  E2EE
}

enum PresenceStatus {
  ONLINE
  IDLE
  DND
  INVISIBLE
}

model User {
  id String @id
  username String @unique
  displayName String?
  bio String?
  avatarVersion Int?
  allowDmsFromServerMembers Boolean @default(true)
  presenceStatus PresenceStatus @default(ONLINE)
  password String
  sessions Session[]

  sentRequests FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  friendshipsA Friendship[] @relation("FriendshipUserA")
  friendshipsB Friendship[] @relation("FriendshipUserB")

  channelMembers ChannelMember[]
  messages Message[]

  ownedServers Server[] @relation("ServerOwner")
  serverMembers ServerMember[]
  createdInvites ServerInvite[]
  receivedBans ServerBan[] @relation("ServerBansReceived")
  issuedBans ServerBan[] @relation("ServerBansIssued")

  avatar Avatar?
}

model Avatar {
  userId            String   @id
  data              Bytes
  contentType       String
  posterData        Bytes?
  posterContentType String?
  updatedAt         DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Server {
  id String @id
  name String
  ownerId String
  iconVersion Int?
  createdAt DateTime @default(now())

  owner User @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ServerMember[]
  channels Channel[]
  categories ChannelCategory[]
  invites ServerInvite[]
  bans ServerBan[]
  roles Role[]
  icon ServerIcon?
}

model ServerIcon {
  serverId          String   @id
  data              Bytes
  contentType       String
  posterData        Bytes?
  posterContentType String?
  updatedAt         DateTime @default(now()) @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model ChannelCategory {
  id String @id
  serverId String
  name String
  position Int @default(0)
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels Channel[]

  @@unique([serverId, name])
}

model ServerInvite {
  id String @id
  code String @unique
  serverId String
  channelId String?
  createdById String
  createdAt DateTime @default(now())
  expiresAt DateTime

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model ServerMember {
  id String @id
  serverId String
  userId String
  joinedAt DateTime @default(now())
  position Int @default(0)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles MemberRole[]

  @@unique([serverId, userId])
  @@index([userId])
  @@index([userId, position])
}

model Role {
  id String @id
  serverId String
  name String
  color Int?
  permissions Int @default(0)
  position Int @default(0)
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members MemberRole[]

  @@unique([serverId, name])
  @@unique([serverId, position])
  @@index([serverId])
}

model MemberRole {
  id String @id
  roleId String
  serverMemberId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  serverMember ServerMember @relation(fields: [serverMemberId], references: [id], onDelete: Cascade)

  @@unique([roleId, serverMemberId])
  @@index([serverMemberId])
}

model ServerBan {
  id         String   @id
  serverId   String
  userId     String
  bannedById String
  reason     String?
  createdAt  DateTime @default(now())

  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user     User   @relation("ServerBansReceived", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy User   @relation("ServerBansIssued", fields: [bannedById], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
  @@index([bannedById])
}

model FriendRequest {
  id String @id
  senderId String
  receiverId String
  createdAt DateTime @default(now())

  sender User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

model Friendship {
  id String @id
  userAId String
  userBId String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Session {
  id String @id
  userId String
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@index([userId])
}

model Channel {
  id String @id
  type ChannelType @default(DM)
  name String?
  serverId String?
  categoryId String?
  dmKey String? @unique
  position Int @default(0)
  createdAt DateTime @default(now())

  members ChannelMember[]
  messages Message[]
  invites ServerInvite[]
  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category ChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([serverId, name])
  @@index([serverId])
  @@index([categoryId])
}

model ChannelMember {
  id String @id
  channelId String
  userId String
  dmVisible Boolean @default(true)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model Message {
  id String @id
  channelId String
  senderId String
  content String
  format MessageFormat @default(TEXT)
  clientNonce String?
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([channelId, senderId, clientNonce])
  @@index([channelId, createdAt, id])
}
